{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "mock"      : "node scripts/seed-test-images.mjs",
    "dev"         : "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:bg"      : "nohup ts-node-dev --respawn --transpile-only src/server.ts",
    "build"       : "tsc",
    "start"       : "node dist/server.js",
    "start:bg"    : "nohup node dist/server.js",
    "cf:dev"      : "tsc && wrangler dev",
    "cf:deploy"   : "tsc && wrangler deploy",
    "kill"        : "npx kill-port 3001",
    "test"        : "jest --runInBand",
    "lint"        : "eslint . --ext .ts",
    "deploy"      : "echo 'deploying api...'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.8.0",
    "mongoose": "^8.5.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "wrangler": "^4.76.0"
  }
}