PORT=3001
MONGODB_URI=mongodb://localhost:27017/virtual-wardrobe

# Storage: 'local' | 's3'
STORAGE_TYPE=local

# Image gen: 'pollinations' | 'huggingface' | 'gemini'
IMAGE_GEN_PROVIDER=pollinations

# Hugging Face
HF_API_KEY=your_hf_key_here
HF_MODEL=stabilityai/stable-diffusion-2

# Google Gemini
GEMINI_API_KEY=your_gemini_key_here

# AWS S3 (only when STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
