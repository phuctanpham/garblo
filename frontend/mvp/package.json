{
  "name": "mvp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev":       "vite",
    "dev:bg":    "npx kill-port 5173 && nohup vite",
    "build":     "tsc -b && vite build",
    "postbuild:dev": "curl -sf \"${VITE_API_URL:-http://localhost:3001}/healthcheck\" > /dev/null && echo '✅ postbuild: API healthcheck OK' || echo '⚠️  postbuild: API unreachable — use ?postbuild= in browser for full validation'",
    "postbuild:prod": "curl -sf \"${VITE_API_URL:-https://api.garblo.workers.dev}/healthcheck\" > /dev/null && echo '✅ postbuild: API healthcheck OK' || echo '⚠️  postbuild: API unreachable — use ?postbuild= in browser for full validation'",
    "kill":      "npx kill-port 5173",
    "preview":   "npx serve ./dist --listen 5173",
    "preview:bg":"nohup npx serve ./dist --listen 5173",
    "cf:dev":    "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:log": "wrangler tail",
    "lint":      "eslint . --ext .ts,.tsx",
    "deploy":    "echo 'deploying mvp...'",
    "cf-typegen":"wrangler types",
    "clean":     "rm -rf dist",
    "test":      "vitest run",
    "test:e2e":  "playwright test"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "lucide-react": "^0.400.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.24.0",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "happy-dom": "^20.8.8",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.64.0"
  }
}